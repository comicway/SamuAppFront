# Modo de autenticacion: "off" (sin control de acceso), "demo" (por defecto:
# ingreso contra el servicio y, si no responde, identidad local de
# demostracion) o "firebase" (Firebase Authentication, la via de produccion).
VITE_AUTH_MODE=demo

# Adaptador de prediccion: "mock" (simulacion local, por defecto) o "http"
# (servicio real desplegado en Render).
VITE_ADAPTADOR_PREDICCION=mock

# URL base del servicio de inferencia. Sin barra final.
# Solo se usa con VITE_ADAPTADOR_PREDICCION=http.
VITE_API_BASE_URL=https://samuapp-backend.onrender.com

# Ruta del endpoint de prediccion (contrato §4.9).
VITE_API_PREDICT_PATH=/api/v1/predictions

# Rutas de identidad. Solo existen cuando el servicio corre con
# SAMUAPP_AUTH_MODE=dev; en produccion el token lo emite Firebase.
VITE_API_AUTH_PATH=/api/v1/auth/sesion
VITE_API_REGISTER_PATH=/api/v1/auth/registro

# Tiempo maximo de espera de la respuesta del servicio, en milisegundos.
VITE_API_TIMEOUT_MS=10000

# Retardo simulado del adaptador mock, en milisegundos.
VITE_MOCK_RETARDO_MS=650

# Fuerza al adaptador mock a responder sin recomendacion, para probar el
# estado sin datos de despacho.
VITE_MOCK_SIN_RECOMENDACION=false

# Firebase Authentication (C-04). El token de identidad viaja despues en la
# cabecera Authorization: Bearer.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_REGION=southamerica-west1
